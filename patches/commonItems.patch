+}
+
+
+bool isValidUTF8(const std::string& text)
+{
+	for (std::size_t i = 0; i < text.size();)
+	{
+		const auto lead = static_cast<unsigned char>(text[i]);
+		std::size_t length = 0;
+		if (lead < 0x80)
+			length = 1;
+		else if ((lead & 0xE0) == 0xC0)
+			length = 2;
+		else if ((lead & 0xF0) == 0xE0)
+			length = 3;
+		else if ((lead & 0xF8) == 0xF0)
+			length = 4;
+		else
+			return false;
+		if (i + length > text.size())
+			return false;
+		for (std::size_t j = 1; j < length; ++j)
+			if ((static_cast<unsigned char>(text[i + j]) & 0xC0) != 0x80)
+				return false;
+		i += length;
+	}
+	return true;
+}
+
+// iconv to Windows-1252 without logging; false if any character can't be represented.
+bool quietUTF8ToWin1252(const std::string& in, std::string& out)
+{
+	const iconv_t descriptor = iconv_open("CP1252//TRANSLIT", "UTF-8");
+	if (descriptor == reinterpret_cast<iconv_t>(-1))
+		return false;
+	std::string buffer(in.size() * 4 + 4, '\0');
+	auto* inPtr = const_cast<char*>(in.data());
+	auto inLeft = in.size();
+	auto* outPtr = buffer.data();
+	auto outLeft = buffer.size();
+	const auto result = iconv(descriptor, &inPtr, &inLeft, &outPtr, &outLeft);
+	iconv_close(descriptor);
+	if (result == static_cast<size_t>(-1) || inLeft != 0)
+		return false;
+	out.assign(buffer.data(), buffer.size() - outLeft);
+	return true;
 }
 
+#ifdef __APPLE__
+// Reduce one character to plain Latin letters (e.g. "ǎ" -> "a", "中" -> "zhong") using the system's ICU transforms.
+std::string latinizeUTF8(const std::string& text)
+{
+	const CFMutableStringRef mutableString = CFStringCreateMutable(nullptr, 0);
+	CFStringAppendCString(mutableString, text.c_str(), kCFStringEncodingUTF8);
+	CFStringTransform(mutableString, nullptr, kCFStringTransformToLatin, false);
+	CFStringTransform(mutableString, nullptr, kCFStringTransformStripCombiningMarks, false);
+	char buffer[256] = {};
+	CFStringGetCString(mutableString, buffer, sizeof buffer, kCFStringEncodingUTF8);
+	CFRelease(mutableString);
+	return buffer;
+}
+#endif
 
 std::string convertUTF8ToWin1252(const std::string& UTF8)
 {
-	return ConvertString<std::string, std::string>("UTF−8", "CP1252//TRANSLIT", UTF8);
+	// Some callers pass text that came from EU4's own (already Windows-1252) files. iconv rejects those
+	// and we'd return an empty string, so pass anything that isn't valid UTF-8 through untouched.
+	if (!isValidUTF8(UTF8))
+		return UTF8;
+	if (std::string converted; quietUTF8ToWin1252(UTF8, converted))
+		return converted;
+
+	// Something has no Windows-1252 equivalent (e.g. pinyin tone marks). Go character by character
+	// rather than losing the whole string, like Windows' converter does.
+	std::string result;
+	for (std::size_t i = 0; i < UTF8.size();)
+	{
+		const auto lead = static_cast<unsigned char>(UTF8[i]);
+		const std::size_t length = lead < 0x80 ? 1 : (lead & 0xE0) == 0xC0 ? 2 : (lead & 0xF0) == 0xE0 ? 3 : 4;
+		const auto character = UTF8.substr(i, length);
+		i += length;
+		if (std::string converted; quietUTF8ToWin1252(character, converted))
+		{
+			result += converted;
+			continue;
+		}
+#ifdef __APPLE__
+		if (std::string converted; quietUTF8ToWin1252(latinizeUTF8(character), converted))
+		{
+			result += converted;
+			continue;
+		}
+#endif
+		result += '?';
+	}
+	return result;
 }
 
