+#ifndef CK3_RITES_H
+#define CK3_RITES_H
+#include "Parser.h"
+#include <map>
+
+namespace CK3
+{
+// CK3 1.20+ saves: characters and counties reference a rite, and each rite belongs to a faith.
+// This only keeps the rite -> faith link so they can be resolved to faiths as before.
+class Rites: commonItems::parser
+{
+  public:
+	Rites() = default;
+	explicit Rites(std::istream& theStream);
+
+	[[nodiscard]] std::optional<long long> getFaithForRite(long long riteID) const;
+	[[nodiscard]] auto size() const { return riteFaiths.size(); }
+
+  private:
+	void registerKeys();
+
+	std::map<long long, long long> riteFaiths; // rite ID -> faith ID
+};
+} // namespace CK3
+
+#endif // CK3_RITES_H
