@@ -63,3 +63,70 @@ TEST(CK3World_FaithsTests, linkingMissingReligionThrowsException)
 
 	ASSERT_THROW(faiths.linkReligions(religions, titles), std::runtime_error);
 }
+
+// --- CK3 1.20: faiths wrapped in database={}, faith_type instead of template=, origin= chains ---
+
+namespace
+{
+const auto knowsCatholic = [](const std::string& name) {
+	return name == "catholic";
+};
+}
+
+TEST(CK3World_FaithsTests, faithsLoadFromDatabaseBlock)
+{
+	std::stringstream input;
+	input << "database={ 13={tag=\"catholic\" faith_type=\"catholic\"} 105={tag=\"dynamic_faith_105\" faith_type=\"catholic\" origin=13} }\n";
+	const CK3::Faiths faiths(input);
+
+	ASSERT_EQ(2, faiths.getFaiths().size());
+	EXPECT_TRUE(faiths.getFaiths().at(13)->getTemplate().empty()); // faith_type equals its own tag -> no template
+	EXPECT_EQ("catholic", faiths.getFaiths().at(105)->getTemplate()); // faith_type differs from tag -> template
+	EXPECT_EQ(13, faiths.getFaiths().at(105)->getOrigin());
+}
+
+TEST(CK3World_FaithsTests, oldStyleTemplateStillWins)
+{
+	std::stringstream input;
+	input << "105={tag=\"dynamic_faith_105\" template=\"catholic\" faith_type=\"orthodox\"}\n";
+	const CK3::Faiths faiths(input);
+
+	EXPECT_EQ("catholic", faiths.getFaiths().at(105)->getTemplate());
+}
+
+TEST(CK3World_FaithsTests, splitsOfSplitsTraceBackToKnownAncestor)
+{
+	// Catholic -> Ambrosian (105) -> a split of Ambrosian (200) -> a split of that (300), where the later
+	// generations name an unknown faith_type or none at all.
+	std::stringstream input;
+	input << "database={\n";
+	input << "13={tag=\"catholic\" faith_type=\"catholic\"}\n";
+	input << "105={tag=\"dynamic_faith_105\" faith_type=\"catholic\" origin=13}\n";
+	input << "200={tag=\"dynamic_faith_200\" faith_type=\"dynamic_faith_105\" origin=105}\n";
+	input << "300={tag=\"dynamic_faith_300\" origin=200}\n";
+	input << "}\n";
+	const CK3::Faiths faiths(input);
+
+	faiths.resolveTemplatesFromOrigins(knowsCatholic);
+
+	EXPECT_EQ("catholic", faiths.getFaiths().at(105)->getTemplate());
+	EXPECT_EQ("catholic", faiths.getFaiths().at(200)->getTemplate());
+	EXPECT_EQ("catholic", faiths.getFaiths().at(300)->getTemplate());
+	EXPECT_TRUE(faiths.getFaiths().at(13)->getTemplate().empty()); // known faiths are left alone
+}
+
+TEST(CK3World_FaithsTests, originLoopsAndDeadEndsAreLeftAlone)
+{
+	std::stringstream input;
+	input << "1={tag=\"dynamic_faith_1\" origin=2}\n";
+	input << "2={tag=\"dynamic_faith_2\" origin=1}\n";		// loop
+	input << "3={tag=\"dynamic_faith_3\" origin=999}\n";	// parent missing from save
+	input << "4={tag=\"dynamic_faith_4\" origin=4294967295}\n"; // no origin
+	const CK3::Faiths faiths(input);
+
+	faiths.resolveTemplatesFromOrigins(knowsCatholic); // must terminate
+
+	for (const auto& faith: faiths.getFaiths())
+		EXPECT_TRUE(faith.second->getTemplate().empty()) << faith.first;
+	EXPECT_FALSE(faiths.getFaiths().at(4)->getOrigin());
+}
