@@ -0,0 +1,36 @@
+#include "Rites.h"
+#include "CommonRegexes.h"
+#include "ParserHelpers.h"
+
+CK3::Rites::Rites(std::istream& theStream)
+{
+	registerKeys();
+	parseStream(theStream);
+	clearRegisteredKeywords();
+}
+
+void CK3::Rites::registerKeys()
+{
+	registerKeyword("database", [this](const std::string& unused, std::istream& theStream) {
+		riteFaiths.merge(Rites(theStream).riteFaiths);
+	});
+	registerRegex(R"(\d+)", [this](const std::string& riteID, std::istream& theStream) {
+		std::optional<long long> faith;
+		commonItems::parser riteParser;
+		riteParser.registerKeyword("faith", [&faith](std::istream& stream) {
+			faith = commonItems::singleLlong(stream).getLlong();
+		});
+		riteParser.registerRegex(commonItems::catchallRegex, commonItems::ignoreItem);
+		riteParser.parseStream(theStream);
+		if (faith && *faith != 4294967295)
+			riteFaiths.emplace(std::stoll(riteID), *faith);
+	});
+	registerRegex(commonItems::catchallRegex, commonItems::ignoreItem);
+}
+
+std::optional<long long> CK3::Rites::getFaithForRite(const long long riteID) const
+{
+	if (const auto& itr = riteFaiths.find(riteID); itr != riteFaiths.end())
+		return itr->second;
+	return std::nullopt;
+}
