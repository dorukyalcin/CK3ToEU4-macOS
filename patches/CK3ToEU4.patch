+
+void CK3::World::resolveRites()
+{
+	// CK3 1.20+ saves give counties and characters a rite instead of a faith; each rite belongs to one faith.
+	if (!rites.size())
+		return;
+	Log(LogLevel::Info) << "-> Resolving rites into faiths.";
+	auto counties = 0;
+	auto people = 0;
+	for (const auto& [name, county]: countyDetails.getCountyDetails())
+		if (county->getRite())
+		{
+			if (const auto& faithID = rites.getFaithForRite(*county->getRite()); faithID)
+			{
+				county->loadFaith(std::make_pair(*faithID, nullptr));
+				++counties;
+			}
+			else
+				Log(LogLevel::Warning) << "County " << name << " has rite " << *county->getRite() << " with no faith!";
+		}
+	for (const auto& character: characters.getCharacters() | std::views::values)
+		if (!character->getFaith() && character->getRite())
+			if (const auto& faithID = rites.getFaithForRite(*character->getRite()); faithID)
+			{
+				character->loadFaith(std::make_pair(*faithID, nullptr));
+				++people;
+			}
+	Log(LogLevel::Info) << "<> " << counties << " counties and " << people << " characters resolved.";
+}
