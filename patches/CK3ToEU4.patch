+	{
+		if (isKnown(faith->getName()) || (!faith->getTemplate().empty() && isKnown(faith->getTemplate())))
+			continue;
+
+		std::set<long long> visited{faith->getID()}; // guards against a malformed save with an origin loop
+		for (auto ancestorID = faith->getOrigin(); ancestorID && !visited.contains(*ancestorID); )
+		{
+			visited.insert(*ancestorID);
+			const auto& ancestorItr = faiths.find(*ancestorID);
+			if (ancestorItr == faiths.end())
+				break;
+			const auto& ancestor = ancestorItr->second;
+			std::string match;
+			if (isKnown(ancestor->getName()))
+				match = ancestor->getName();
+			else if (!ancestor->getTemplate().empty() && isKnown(ancestor->getTemplate()))
+				match = ancestor->getTemplate();
+			if (!match.empty())
+			{
+				Log(LogLevel::Info) << "Faith " << faith->getName() << " (" << faith->getCustomName() << ") traced through its origins to " << match << ".";
+				faith->setTemplate(match);
+				++counter;
+				break;
+			}
+			ancestorID = ancestor->getOrigin();
+		}
+	}
+	Log(LogLevel::Info) << "<> " << counter << " faith templates resolved through origins.";
+}
